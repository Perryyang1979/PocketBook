<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PocketBookClient.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:view="clr-namespace:PocketBookClient.View"
    xmlns:local="clr-namespace:PocketBookClient"
    Shell.FlyoutBehavior="Flyout"
    Shell.TabBarIsVisible="false">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="True" IsVisible="false"/>
    </Shell.BackButtonBehavior>

    <Shell.FlyoutHeader>
        <VerticalStackLayout>
        <Image Source="me.png" WidthRequest="100" HeightRequest="200"></Image>
            <Label Text="{Binding LoginUserName}" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}"></Label>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>


    <Shell.FlyoutFooter>
        <VerticalStackLayout Margin="20">
            <Button x:Name="logoutButton" Style="{StaticResource ButtonOutline}" Text="{Binding LocalizationResourceManager[LogOut], Mode=OneWay}" WidthRequest="100" HeightRequest="40" Margin="10"
                    Clicked="logoutButton_Clicked"
                    IsVisible="{Binding LogoutButtonVisible}"
                    ></Button>
            <Button x:Name="loginButton" Style="{StaticResource ButtonOutline}" Text="{Binding LocalizationResourceManager[Login], Mode=OneWay}" WidthRequest="100" HeightRequest="40" Margin="10"
         Clicked="logoutButton_Clicked"
         IsVisible="{Binding LoginButtonVisible}"
         ></Button>

            <!--<Button x:Name="UserButton" Style="{StaticResource ButtonOutline}" Text="User" WidthRequest="100" HeightRequest="40" Margin="10"
            Clicked="UserButton_Clicked"
            IsVisible="{Binding UserButtonVisible}"
            ></Button>-->
            <Label Text="@Ver.2025.1.0" HorizontalTextAlignment="Center" 
                   ></Label>
            <Label Text="@Copyright Mr.Yang-2024" HorizontalTextAlignment="Center" ></Label>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <Shell.Resources>
        <ResourceDictionary>
            <Style x:Key="BaseStyle" TargetType="Element">
                <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Dark=Black, Light=White}" />
                <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Dark=White, Light=Black}" />
                <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Dark=White, Light=Black}" />
                <Setter Property="Shell.DisabledColor" Value="#B4FFFFFF" />
                <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Dark=#95FFFFFF, Light=#95000000}" />
                <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Dark=Black, Light=White}" />
                <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Dark=White, Light=Black}" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Dark=#95FFFFFF, Light=#95000000}" />
                <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Dark=White, Light=Black}" />
            </Style>
            <Style BasedOn="{StaticResource BaseStyle}" TargetType="TabBar" />
            <Style BasedOn="{StaticResource BaseStyle}" TargetType="FlyoutItem" />

           
            <Style Class="FlyoutItemLabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style
               ApplyToDerivedTypes="True"
               Class="FlyoutItemLayoutStyle"
               TargetType="Layout">
                <Setter Property="BackgroundColor" Value="LightBlue" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                    <Setter TargetName="FlyoutItemLabel" Property="Label.TextColor" Value="{StaticResource Primary}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!--
               Custom Style you can apply to any Flyout Item
           -->
            <Style
               ApplyToDerivedTypes="True"
               Class="MenuItemLayoutStyle"
               TargetType="Layout">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter TargetName="FlyoutItemLabel" Property="Label.TextColor" Value="{StaticResource Primary}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Shell.Resources>


    <ShellItem  FlyoutItemIsVisible="false">
        <ShellContent ContentTemplate="{DataTemplate view:LoginPage}" Route="LoginPage"/>
    </ShellItem>


    <FlyoutItem Title="Main" FlyoutDisplayOptions="AsMultipleItems" IsVisible="{Binding HomeItemEnable}">

        <ShellContent Title ="" ContentTemplate="{DataTemplate view:LoginPage}" Route="LoginPage"/>
        <ShellContent Icon="home.png" Title="Home" 
        ContentTemplate="{DataTemplate view:AddTransactionPage}"
        Route="AddTransactionPage" />
        
        <ShellContent Icon="report.png" Title="Report" 
        ContentTemplate="{DataTemplate view:AdvancedReportPage}"
        Route="AdvancedReportPage" />

        <ShellContent Icon="schedule.png" Title="Schedule" 
        ContentTemplate="{DataTemplate view:ScheduleTransactionPage}"
        Route="ScheduleTransactionPage" />

        <ShellContent Icon="me.png" Title="Me" 
               ContentTemplate="{DataTemplate view:UserInfoPage}"
           Route="UserInfoPage"  />

        <ShellContent 
        ContentTemplate="{DataTemplate view:SettingPage}" Icon="setting.png" Title="Setting"
        Route="SettingPage"></ShellContent>

    </FlyoutItem>
    
    
    
    <!--<FlyoutItem Icon="setting.png" Title="Setting" FlyoutDisplayOptions="AsSingleItem" >-->
        <!--<ShellContent 
ContentTemplate="{DataTemplate view:SettingPage}" Icon="setting.png" Title="Setting"
Route="SettingPage" /-->

    <!--</FlyoutItem>-->


    <!--<MenuItem Text="Setting"
              IconImageSource="setting.png"
              Command="{Binding SettingRouteCommand}" />-->



</Shell>
