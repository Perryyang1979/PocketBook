<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PocketBookClient.View.MultiCheckBoxContentView"
              xmlns:data="clr-namespace:PocketBookClient.Data"
             >
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <VerticalStackLayout>
                <Label Text="{TemplateBinding Title}" FontSize="Micro" TextColor="{StaticResource Primary}" VerticalOptions="Center" HorizontalOptions="Start"/>
                <ScrollView Orientation="Vertical">
                    <CollectionView ItemsSource="{TemplateBinding ItemsOptionSource, Mode=TwoWay}" 
                                    SelectedItems="{TemplateBinding SelectedOptionItems,Mode=TwoWay}" 
                              >
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="0" HorizontalItemSpacing="10" Span="2" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="data:SelectOption" >
                                <Frame Padding="2" BackgroundColor="LightBlue" x:Name="optionSelect" CornerRadius="0" HeightRequest="30" WidthRequest="200" HorizontalOptions="Center" Margin="10,5">
                                    <Grid  RowDefinitions="Auto,Auto" ColumnDefinitions="30,*">
                                        <CheckBox Grid.Column="0"  IsChecked="{Binding IsSelected}" Margin="0,-8" HeightRequest="20" CheckedChanged="CheckBox_CheckedChanged"/>
                                        <Label  Padding="5" FontSize="Small" Text="{Binding Name}" Grid.Column="1" Margin="0,-6"></Label>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>
            </VerticalStackLayout>

        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
