<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PocketBookClient.View.AdvancedReportPage"
             xmlns:viewmodel="clr-namespace:PocketBookClient.ViewModel"
             xmlns:local="clr-namespace:PocketBookClient.View"
             xmlns:data="clr-namespace:PocketBookClient.Data"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             Title="{Binding LocalizationResourceManager[Advance_Report_Title], Mode=OneWay}"
            x:DataType="viewmodel:AdvancedReportViewModel" MinimumWidthRequest="300">
    <ScrollView  >
        <Grid
      ColumnDefinitions="*"
      ColumnSpacing="5"
      RowDefinitions="Auto,Auto,60"
      RowSpacing="0">
            <StackLayout Grid.Row="0"  Grid.ColumnSpan="2" x:Name="MonthlyReportPanel">
                <Label  Text="{Binding LocalizationResourceManager[Advance_Report_MonthSummary], Mode=OneWay}" Margin="0,10" HorizontalOptions="Center" TextColor="{StaticResource Primary}" FontSize="Medium"/>
                <Grid ColumnDefinitions="45*,30*,25*,25*,40*" >
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Date], Mode=OneWay}" Grid.Row="1" Grid.Column="0" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_User], Mode=OneWay}" Grid.Row="1" Grid.Column="1" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Money], Mode=OneWay}" Grid.Row="1" Grid.Column="2" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Income], Mode=OneWay}" Grid.Row="1" Grid.Column="3" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Category], Mode=OneWay}" Grid.Row="1" Grid.Column="4" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                </Grid>

                <CollectionView 
                  ItemsSource="{Binding MonthTransactionList}"
                  SelectionMode="None"
                      >
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:UserTransaction">
                            <Grid Margin="10,2,0,0" RowSpacing="4" RowDefinitions="Auto" ColumnDefinitions="45*,30*,25*,25*,40*" VerticalOptions="FillAndExpand">
                                <!--<BoxView HeightRequest="0.1"  BackgroundColor="Black" Grid.ColumnSpan="5" VerticalOptions="Start"/>-->
                                <Label Text="{Binding Date}" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                                <Label Text="{Binding UserName}" FontAttributes="Bold" Grid.Row="1" Grid.Column="1"/>
                                <Label Text="{Binding Amount}" FontAttributes="Bold" Grid.Row="1" Grid.Column="2"/>
                                <Label Text="{Binding CurrentInOutLable}" FontAttributes="Bold" Grid.Row="1" Grid.Column="3"/>
                                <Label Text="{Binding Category}" FontAttributes="Bold" Grid.Row="1" Grid.Column="4"/>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label  Text="{Binding LocalizationResourceManager[PocketOperation_Month_ShowReportTitle], Mode=OneWay}" Margin="0,10" HorizontalOptions="Center" TextColor="{StaticResource Primary}" FontSize="Micro"/>
                <Grid ColumnDefinitions="30*,35*,35*,35*,35*" >
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Date], Mode=OneWay}" Grid.Row="1" Grid.Column="0" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_User], Mode=OneWay}" Grid.Row="1" Grid.Column="1" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[Table_Identify_Header], Mode=OneWay}" Grid.Row="1" Grid.Column="2" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[AddTranscation_IsIncome_Income], Mode=OneWay}" Grid.Row="1" Grid.Column="3" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[AddTranscation_IsIncome_Expense], Mode=OneWay}" Grid.Row="1" Grid.Column="4" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                </Grid>

                <CollectionView 
                  ItemsSource="{Binding MonthSummaryList}"
                  SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:MonthlySummary">
                            <Grid Margin="10,2,0,0" RowSpacing="4" RowDefinitions="Auto" ColumnDefinitions="30*,35*,35*,35*,35*" VerticalOptions="FillAndExpand">
                                <!--<BoxView HeightRequest="0.1"  BackgroundColor="Black" Grid.ColumnSpan="5" VerticalOptions="Start"/>-->
                                <Label Text="{Binding Date}" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                                <Label Text="{Binding UserName}" FontAttributes="Bold" Grid.Row="1" Grid.Column="1"/>
                                <Label Text="{Binding Identify}" FontAttributes="Bold" Grid.Row="1" Grid.Column="2"/>
                                <Label Text="{Binding TotalIncome}" FontAttributes="Bold" Grid.Row="1" Grid.Column="3"/>
                                <Label Text="{Binding TotalExpense}" FontAttributes="Bold" Grid.Row="1" Grid.Column="4"/>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>


                <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                    <Label  Text="{Binding LocalizationResourceManager[PocketOperation_Month_ShowChart_Label_Switch], Mode=OneWay}" Margin="5,10" 
                              IsVisible="{Binding MonthlyChartEnabled}"
                            HorizontalOptions="StartAndExpand" TextColor="{StaticResource Primary}" FontSize="Small">
                    </Label>
                    <Switch x:Name="MonthChartSwitch" ThumbColor="{StaticResource Primary}" OnColor="{StaticResource Gray200}"  
                      IsVisible="{Binding MonthlyChartEnabled}"
                      HeightRequest="60"  Margin="10,0,0,0" IsToggled="{Binding MonthlyChartSwtichToggled}"/>
                </HorizontalStackLayout>


                <StackLayout IsVisible="{Binding MonthlyChartPanelVisible}">

                    <microcharts:ChartView x:Name="expensechartView"   Margin="10,10,10,10"                                                                                                       
                                                     BackgroundColor="White"
                                                     Chart="{Binding ExpenseChart}"
                                                     HeightRequest="250" 
                                     IsVisible="{Binding MonthSummaryExpenseChartVisible}"/>
                    <Label  Text="{Binding LocalizationResourceManager[PocketOperation_Month_ShowReport_Label_Expense], Mode=OneWay}"
                          Margin="0,-15"
                          HorizontalOptions="CenterAndExpand" TextColor="{StaticResource Gray300}" FontSize="Small"/>

                    <microcharts:ChartView x:Name="incomechartView"   Margin="10,15,10,10"                                                                                                       
                                                     BackgroundColor="White"
                                                     Chart="{Binding IncomeChart}"                                       
                                                     HeightRequest="250" 
                                     IsVisible="{Binding MonthSummaryIncomeChartVisible}"/>
                    <Label  Text="{Binding LocalizationResourceManager[PocketOperation_Month_ShowReport_Label_Income], Mode=OneWay}"
                          Margin="0,-15"
                          HorizontalOptions="CenterAndExpand" TextColor="{StaticResource Gray300}" FontSize="Small"/>
                </StackLayout>


                <HorizontalStackLayout Grid.Row="0"  Grid.ColumnSpan="2">
                    <Label  
                  Text="{Binding LocalizationResourceManager[PocketOperation_CategoryMonth_ShowReport], Mode=OneWay}" HeightRequest="60"
                      Margin="5,0,0,0" HorizontalOptions="StartAndExpand" TextColor="{StaticResource Primary}" FontSize="Small" VerticalTextAlignment="Center">
                    </Label>
                    <Switch x:Name="MonthCategoryReportSwitch" ThumbColor="{StaticResource Primary}" OnColor="{StaticResource Gray200}"  HeightRequest="60"  Margin="10,25,0,0" IsToggled="{Binding CategoryReportSwtichToggled}"/>
                </HorizontalStackLayout>

                <StackLayout x:Name="CategorySummaryPanel" IsVisible="{Binding MonthlyCategoryReprotPanelVisible,Mode=TwoWay}">

                    <Label  Text="{Binding LocalizationResourceManager[PocketOperation_CategoryMonth_ShowReportTitle], Mode=OneWay}" Margin="0,10" HorizontalOptions="Center" TextColor="{StaticResource Primary}" FontSize="Micro"/>

                    <StackLayout Orientation="Vertical" Margin="10">

                        <local:MultiCheckBoxContentView Title ="{Binding LocalizationResourceManager[PocketOperation_Header_Category], Mode=OneWay}"
                      ItemsOptionSource="{Binding CurrentCategorys, Mode=TwoWay}" SelectedOptionItems="{Binding SelectedCurrentCategorys,Mode=TwoWay}" MinimumWidthRequest="300" />

                    </StackLayout>
                    <microcharts:ChartView x:Name="categorychartView"   Margin="10,10,10,10"                                                                                                       
                                                     BackgroundColor="White"
                                                     Chart="{Binding CategoryChart}"
                                                     HeightRequest="250" IsVisible="{Binding CategoryChartVisble}"/>
                </StackLayout>

            </StackLayout>
            <ActivityIndicator
          Grid.RowSpan="2"
          Grid.ColumnSpan="2"
          HorizontalOptions="Fill"
          IsRunning="{Binding IsBusy}"
          IsVisible="{Binding IsBusy}"
          Color="{StaticResource Primary}"
          VerticalOptions="Center" />
        </Grid>


    </ScrollView>
</ContentPage>