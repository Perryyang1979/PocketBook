<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PocketBookClient.View.AdvancedReportPage"
             xmlns:viewmodel="clr-namespace:PocketBookClient.ViewModel"
             xmlns:local="clr-namespace:PocketBookClient.View"
             xmlns:data="clr-namespace:PocketBookClient.Data"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             Title="{Binding LocalizationResourceManager[Advance_Report_Title], Mode=OneWay}"
            x:DataType="viewmodel:AdvancedReportViewModel" MinimumWidthRequest="300">
    <ScrollView  >
        <Grid
      ColumnDefinitions="*"
      ColumnSpacing="5"
      RowDefinitions="Auto,Auto,60"
      RowSpacing="0">
            <StackLayout Grid.Row="0"  Grid.ColumnSpan="2" x:Name="MonthlyReportPanel">
                <Label  Text="{Binding LocalizationResourceManager[Advance_Report_MonthSummary], Mode=OneWay}" Margin="0,10" HorizontalOptions="Center" TextColor="{StaticResource Primary}" FontSize="Medium"/>
                <Grid ColumnDefinitions="35*,30*,30*,30*,45*" HorizontalOptions="FillAndExpand">
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Date], Mode=OneWay}" Grid.Row="1" Grid.Column="0" Padding="10" Style="{StaticResource HeadSmallLabel }"  />
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_User], Mode=OneWay}" Grid.Row="1" Grid.Column="1" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Money], Mode=OneWay}" Grid.Row="1" Grid.Column="2" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Income], Mode=OneWay}" Grid.Row="1" Grid.Column="3" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Category], Mode=OneWay}" Grid.Row="1" Grid.Column="4" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                </Grid>

                <CollectionView 
                  ItemsSource="{Binding MonthTransactionList}"
                  SelectionMode="None"
                      >
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:UserTransaction">
                            <Grid Margin="10,2,0,0" RowSpacing="4" RowDefinitions="Auto" ColumnDefinitions="35*,30*,30*,30*,45*" VerticalOptions="FillAndExpand">
                                <!--<BoxView HeightRequest="0.1"  BackgroundColor="Black" Grid.ColumnSpan="5" VerticalOptions="Start"/>-->
                                <Label Text="{Binding Date}" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                                <Label Text="{Binding UserName}" FontAttributes="Bold" Grid.Row="1" Grid.Column="1"/>
                                <Label Text="{Binding Amount}" FontAttributes="Bold" Grid.Row="1" Grid.Column="2"/>
                                <Label Text="{Binding CurrentInOutLable}" FontAttributes="Bold" Grid.Row="1" Grid.Column="3"/>
                                <Label Text="{Binding Category}" FontAttributes="Bold" Grid.Row="1" Grid.Column="4"/>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--Monthly summary-->
                <Label  Text="{Binding LocalizationResourceManager[PocketOperation_Month_ShowReportTitle], Mode=OneWay}" Margin="0,10" HorizontalOptions="Center" TextColor="{StaticResource Primary}" FontSize="Micro"/>
                <Grid ColumnDefinitions="30*,35*,35*,35*">
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Date], Mode=OneWay}" Grid.Row="1" Grid.Column="0" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_User], Mode=OneWay}" Grid.Row="1" Grid.Column="1" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[AddTranscation_IsIncome_Income], Mode=OneWay}" Grid.Row="1" Grid.Column="2" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[AddTranscation_IsIncome_Expense], Mode=OneWay}" Grid.Row="1" Grid.Column="3" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                </Grid>

                <CollectionView 
                  ItemsSource="{Binding MonthSummaryList}"
                  SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:MonthlySummary">
                            <Grid Margin="10,2,0,0" RowSpacing="4" RowDefinitions="Auto" ColumnDefinitions="30*,35*,35*,35*" VerticalOptions="FillAndExpand">
                                <!--<BoxView HeightRequest="0.1"  BackgroundColor="Black" Grid.ColumnSpan="5" VerticalOptions="Start"/>-->
                                <Label Text="{Binding Date}" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                                <Label Text="{Binding UserName}" FontAttributes="Bold" Grid.Row="1" Grid.Column="1"/>
                                <Label Text="{Binding TotalIncome}" FontAttributes="Bold" Grid.Row="1" Grid.Column="2"/>
                                <Label Text="{Binding TotalExpense}" FontAttributes="Bold" Grid.Row="1" Grid.Column="3"/>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--Yearly summary-->
                <Label  Text="{Binding LocalizationResourceManager[Advance_Report_MonthSummaryByPerson], Mode=OneWay}" Margin="0,10" HorizontalOptions="Center" TextColor="{StaticResource Primary}" FontSize="Micro"/>
                <Grid ColumnDefinitions="30*,35*,35*,35*" >
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_User], Mode=OneWay}" Grid.Row="1" Grid.Column="0" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[AddTranscation_IsIncome_Income], Mode=OneWay}" Grid.Row="1" Grid.Column="1" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[AddTranscation_IsIncome_Expense], Mode=OneWay}" Grid.Row="1" Grid.Column="2" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[Advance_Report_YealySummary_Balance], Mode=OneWay}" Grid.Row="1" Grid.Column="3" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                </Grid>

                <CollectionView 
                ItemsSource="{Binding YearlySummaryList}"
                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:YearlySummary">
                            <Grid Margin="10,2,0,0" RowSpacing="4" RowDefinitions="Auto" ColumnDefinitions="30*,35*,35*,35*" VerticalOptions="FillAndExpand">
                                <Label Text="{Binding UserName}" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                                <Label Text="{Binding TotalIncome}" FontAttributes="Bold" Grid.Row="1" Grid.Column="1"/>
                                <Label Text="{Binding TotalExpense}" FontAttributes="Bold" Grid.Row="1" Grid.Column="2"/>
                                <Label Text="{Binding Balance}" FontAttributes="Bold" Grid.Row="1" Grid.Column="3"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--Optional summary Identify-->
                <!--<StackLayout IsVisible="{Binding YearlyIdentificationSummarylVisible}">

                    <Grid ColumnDefinitions="30*,35*,35*,35*" >
                        <Label Text="{Binding LocalizationResourceManager[Table_Identify_Header], Mode=OneWay}" Grid.Row="1" Grid.Column="0" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                        <Label Text="{Binding LocalizationResourceManager[AddTranscation_IsIncome_Income], Mode=OneWay}" Grid.Row="1" Grid.Column="1" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                        <Label Text="{Binding LocalizationResourceManager[AddTranscation_IsIncome_Expense], Mode=OneWay}" Grid.Row="1" Grid.Column="2" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                        <Label Text="{Binding LocalizationResourceManager[Advance_Report_YealySummary_Balance], Mode=OneWay}" Grid.Row="1" Grid.Column="3" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    </Grid>

                    <CollectionView 
                         ItemsSource="{Binding YearlySpecialIdentifySummaryList}"
                         SelectionMode="None">      
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="data:YearlySummary">
                                <Grid Margin="10,2,0,0" RowSpacing="4" RowDefinitions="Auto" ColumnDefinitions="30*,35*,35*,35*" VerticalOptions="FillAndExpand">
                                    <Label Text="{Binding UserName}" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                                    <Label Text="{Binding TotalIncome}" FontAttributes="Bold" Grid.Row="1" Grid.Column="1"/>
                                    <Label Text="{Binding TotalExpense}" FontAttributes="Bold" Grid.Row="1" Grid.Column="2"/>
                                    <Label Text="{Binding Balance}" FontAttributes="Bold" Grid.Row="1" Grid.Column="3"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </StackLayout>-->
                <!--Optional report-->
                <HorizontalStackLayout HorizontalOptions="CenterAndExpand">
                    <Label  Text="{Binding LocalizationResourceManager[PocketOperation_Month_ShowChart_Label_Switch], Mode=OneWay}" Margin="5,10" 
                              IsVisible="{Binding MonthlyChartEnabled}"
                            HorizontalOptions="StartAndExpand" TextColor="{StaticResource Primary}" FontSize="Small">
                    </Label>
                    <Switch x:Name="MonthChartSwitch" ThumbColor="{StaticResource Primary}" OnColor="{StaticResource Gray200}"  
                      IsVisible="{Binding MonthlyChartEnabled}"
                      HeightRequest="60"  Margin="10,0,0,0" IsToggled="{Binding MonthlyChartSwtichToggled}"/>
                </HorizontalStackLayout>


                <StackLayout IsVisible="{Binding MonthlyChartPanelVisible ,Mode=TwoWay}">

                    <microcharts:ChartView x:Name="expensechartView"   Margin="10,10,10,10"                                                                                                       
                                                     BackgroundColor="White"
                                                     Chart="{Binding ExpenseChart}"
                                                     HeightRequest="250" 
                                     IsVisible="{Binding MonthSummaryExpenseChartVisible}"/>
                    <Label  Text="{Binding LocalizationResourceManager[PocketOperation_Month_ShowReport_Label_Expense], Mode=OneWay}"
                          Margin="0,-15"
                          HorizontalOptions="CenterAndExpand" TextColor="{StaticResource Gray300}" FontSize="Small"/>

                    <microcharts:ChartView x:Name="incomechartView"   Margin="10,15,10,10"                                                                                                       
                                                     BackgroundColor="White"
                                                     Chart="{Binding IncomeChart}"                                       
                                                     HeightRequest="250" 
                                     IsVisible="{Binding MonthSummaryIncomeChartVisible}"/>
                    <Label  Text="{Binding LocalizationResourceManager[PocketOperation_Month_ShowReport_Label_Income], Mode=OneWay}"
                          Margin="0,-15"
                          HorizontalOptions="CenterAndExpand" TextColor="{StaticResource Gray300}" FontSize="Small"/>
                </StackLayout>

            </StackLayout>

            <StackLayout Grid.Row="1"  Grid.ColumnSpan="2">
                <HorizontalStackLayout >
                    <Label  
                  Text="{Binding LocalizationResourceManager[PocketOperation_CategoryMonth_ShowReport], Mode=OneWay}" HeightRequest="60"
                      Margin="5,0,0,0" HorizontalOptions="StartAndExpand" TextColor="{StaticResource Primary}" FontSize="Small" VerticalTextAlignment="Center">
                    </Label>
                    <Switch x:Name="MonthCategoryReportSwitch" ThumbColor="{StaticResource Primary}" OnColor="{StaticResource Gray200}"  HeightRequest="60"  Margin="10,25,0,0" IsToggled="{Binding CategoryReportSwtichToggled}"/>
                </HorizontalStackLayout>

                <StackLayout x:Name="CategorySummaryPanel" IsVisible="{Binding MonthlyCategoryReprotPanelVisible,Mode=TwoWay}">

                    <Label  Text="{Binding LocalizationResourceManager[PocketOperation_CategoryMonth_ShowReportTitle], Mode=OneWay}" Margin="0,10" HorizontalOptions="Center" TextColor="{StaticResource Primary}" FontSize="Micro"/>

                    <StackLayout Orientation="Vertical" Margin="10">

                        <local:MultiCheckBoxContentView Title ="{Binding LocalizationResourceManager[PocketOperation_Header_Category], Mode=OneWay}"
                      ItemsOptionSource="{Binding CurrentCategorys, Mode=TwoWay}" SelectedOptionItems="{Binding SelectedCurrentCategorys,Mode=TwoWay}" MinimumWidthRequest="300" />

                    </StackLayout>

                    <!--Optional CATELOG SUMMARY-->
                    <StackLayout IsVisible="{Binding GridCategorySummaryVisible}">

                        <Grid ColumnDefinitions="30*,35*,35*,35*,35*" >
                            <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Date], Mode=OneWay}" Grid.Row="0" Grid.Column="0" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                            <Label Text="{Binding TitleOfFirstCategory, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" Padding="10" Style="{StaticResource HeadSmallLabel }" />
                            <Label Text="{Binding TitleOfSecondCategory, Mode=TwoWay}" Grid.Row="0" Grid.Column="2" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                            <Label Text="{Binding TitleOfThirdCategory, Mode=TwoWay}" Grid.Row="0" Grid.Column="3" Padding="10" Style="{StaticResource HeadSmallLabel }" />
                            <Label Text="{Binding TitleOfFourthCategory, Mode=TwoWay}" Grid.Row="0" Grid.Column="4" Padding="10" Style="{StaticResource HeadSmallLabel }" />
                        </Grid>

                        <CollectionView 
                        ItemsSource="{Binding SelectedCategorySummaryList}"
                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="data:GridCategoryData">
                                    <Grid Margin="10,2,0,0" RowSpacing="4" RowDefinitions="Auto" ColumnDefinitions="30*,35*,35*,35*,35*" VerticalOptions="FillAndExpand">
                                        <Label Text="{Binding Date}" FontAttributes="Bold" Grid.Row="0" Grid.Column="0"/>
                                        <Label Text="{Binding CategoryMoney[0]}" FontAttributes="Bold" Grid.Row="0" Grid.Column="1" IsVisible="{Binding SelectedCategoryColumnVisible[0]}"/>
                                        <Label Text="{Binding CategoryMoney[1]}" FontAttributes="Bold" Grid.Row="0" Grid.Column="2" IsVisible="{Binding SelectedCategoryColumnVisible[1]}"/>
                                        <Label Text="{Binding CategoryMoney[2]}" FontAttributes="Bold" Grid.Row="0" Grid.Column="3" IsVisible="{Binding SelectedCategoryColumnVisible[2]}"/>
                                        <Label Text="{Binding CategoryMoney[3]}" FontAttributes="Bold" Grid.Row="0" Grid.Column="4" IsVisible="{Binding SelectedCategoryColumnVisible[3]}"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </StackLayout>


                    <microcharts:ChartView x:Name="categorychartView"   Margin="10,10,10,10"                                                                                                       
                                                     BackgroundColor="White"
                                                     Chart="{Binding CategoryChart}"
                                                     HeightRequest="250" IsVisible="{Binding CategoryChartVisble}"/>
                </StackLayout>

            </StackLayout>
            <ActivityIndicator
          Grid.RowSpan="2"
          Grid.ColumnSpan="2"
          HorizontalOptions="Fill"
          IsRunning="{Binding IsBusy}"
          IsVisible="{Binding IsBusy}"
          Color="{StaticResource Primary}"
          VerticalOptions="Center" />
        </Grid>


    </ScrollView>
</ContentPage>