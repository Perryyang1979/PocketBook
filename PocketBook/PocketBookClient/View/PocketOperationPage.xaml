<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PocketBookClient.View.PocketOperationPage"
             xmlns:viewmodel="clr-namespace:PocketBookClient.ViewModel"
              xmlns:data="clr-namespace:PocketBookClient.Data"
             Title="{Binding LocalizationResourceManager[PocketOperatint_Title], Mode=OneWay}"
             x:DataType="viewmodel:PocketOperationViewModel" MinimumWidthRequest="300">
    <ScrollView  >
        <Grid
        ColumnDefinitions="*"
        ColumnSpacing="5"
        RowDefinitions="Auto,60,Auto,Auto,60,Auto"
        RowSpacing="0">

            <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="2">
                <Button
                Margin="2"
                Command="{Binding PocketRecordCommand}"
                Style="{StaticResource WiderButtonOutline}"
                Text="{Binding LocalizationResourceManager[PocketOperation_Add_Label], Mode=OneWay}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="35*,40*,25*,25*,40*" Grid.Row="1">
                <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Date], Mode=OneWay}" Grid.Row="1" Grid.Column="0" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_User], Mode=OneWay}" Grid.Row="1" Grid.Column="1" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Money], Mode=OneWay}" Grid.Row="1" Grid.Column="2" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Income], Mode=OneWay}" Grid.Row="1" Grid.Column="3" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Category], Mode=OneWay}" Grid.Row="1" Grid.Column="4" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
            </Grid>

            <CollectionView Grid.Row="2"
                    ItemsSource="{Binding TransactionList}"
                    SelectionMode="None"
                        >
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:UserTransaction">
                        <Grid Margin="10,2,0,0" RowSpacing="4" RowDefinitions="Auto" ColumnDefinitions="35*,40*,25*,25*,40*" VerticalOptions="FillAndExpand">
                            <!--<BoxView HeightRequest="0.1"  BackgroundColor="Black" Grid.ColumnSpan="5" VerticalOptions="Start"/>-->
                            <Label Text="{Binding Date}" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                            <Label Text="{Binding UserName}" FontAttributes="Bold" Grid.Row="1" Grid.Column="1"/>
                            <Label Text="{Binding Amount}" FontAttributes="Bold" Grid.Row="1" Grid.Column="2"/>
                            <Label Text="{Binding CurrentInOutLable}" FontAttributes="Bold" Grid.Row="1" Grid.Column="3"/>
                            <Label Text="{Binding Category}" FontAttributes="Bold" Grid.Row="1" Grid.Column="4"/>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <StackLayout Grid.Row="3" Grid.RowSpan="3" Grid.ColumnSpan="2">
            <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="1">
                <Button
                Margin="2"
                Command="{Binding PocketMonthRecordCommand}"
                Style="{StaticResource ButtonOutline}"
                Text="{Binding LocalizationResourceManager[PocketOperation_Month_Label], Mode=OneWay}" HorizontalOptions="Start" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="35*,40*,25*,25*,40*" Grid.Row="4">
                <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Date], Mode=OneWay}" Grid.Row="1" Grid.Column="0" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_User], Mode=OneWay}" Grid.Row="1" Grid.Column="1" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Money], Mode=OneWay}" Grid.Row="1" Grid.Column="2" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Income], Mode=OneWay}" Grid.Row="1" Grid.Column="3" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Category], Mode=OneWay}" Grid.Row="1" Grid.Column="4" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
            </Grid>

            <CollectionView Grid.Row="5"
                    ItemsSource="{Binding MonthTransactionList}"
                    SelectionMode="None"
                        >
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="data:UserTransaction">
                        <Grid Margin="10,2,0,0" RowSpacing="4" RowDefinitions="Auto" ColumnDefinitions="35*,40*,25*,25*,40*" VerticalOptions="FillAndExpand">
                            <!--<BoxView HeightRequest="0.1"  BackgroundColor="Black" Grid.ColumnSpan="5" VerticalOptions="Start"/>-->
                            <Label Text="{Binding Date}" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                            <Label Text="{Binding UserName}" FontAttributes="Bold" Grid.Row="1" Grid.Column="1"/>
                            <Label Text="{Binding Amount}" FontAttributes="Bold" Grid.Row="1" Grid.Column="2"/>
                            <Label Text="{Binding CurrentInOutLable}" FontAttributes="Bold" Grid.Row="1" Grid.Column="3"/>
                            <Label Text="{Binding Category}" FontAttributes="Bold" Grid.Row="1" Grid.Column="4"/>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

                <Grid ColumnDefinitions="35*,35*,30*" Grid.Row="4">
                    <Label Text="{Binding LocalizationResourceManager[PocketOperation_Header_Date], Mode=OneWay}" Grid.Row="1" Grid.Column="0" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[AddTranscation_IsIncome_Income], Mode=OneWay}" Grid.Row="1" Grid.Column="1" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                    <Label Text="{Binding LocalizationResourceManager[AddTranscation_IsIncome_Expense], Mode=OneWay}" Grid.Row="1" Grid.Column="2" Padding="10" Style="{StaticResource HeadSmallLabel }"/>
                   
                </Grid>

                <CollectionView Grid.Row="3"
                    ItemsSource="{Binding MonthSummaryList}"
                    SelectionMode="None"
                        >
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="data:MonthlySummary">
                            <Grid Margin="10,2,0,0" RowSpacing="4" RowDefinitions="Auto" ColumnDefinitions="35*,35*,30*" VerticalOptions="FillAndExpand">
                                <!--<BoxView HeightRequest="0.1"  BackgroundColor="Black" Grid.ColumnSpan="5" VerticalOptions="Start"/>-->
                                <Label Text="{Binding Date}" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                                <Label Text="{Binding TotalIncome}" FontAttributes="Bold" Grid.Row="1" Grid.Column="1"/>
                                <Label Text="{Binding TotalExpense}" FontAttributes="Bold" Grid.Row="1" Grid.Column="2"/>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </StackLayout>
            <ActivityIndicator
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            HorizontalOptions="Fill"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{StaticResource Primary}"
            VerticalOptions="Center" />
        </Grid>
        
        
    </ScrollView>
</ContentPage>