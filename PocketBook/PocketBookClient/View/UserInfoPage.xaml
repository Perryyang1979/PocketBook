<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PocketBookClient.View.UserInfoPage"
             xmlns:viewmodel="clr-namespace:PocketBookClient.ViewModel"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             
             x:DataType="viewmodel:UserInfoPageViewModel">
    <VerticalStackLayout IsVisible="{Binding PanelVisble}" Margin="20,10">
        <Label 
            Text="{Binding UserName}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label  Text="{Binding LocalizationResourceManager[Password_Manage_Change], Mode=OneWay}" HorizontalOptions="Center" TextColor="{StaticResource Primary}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding  Path=ChangePasswordCommand}"/>
            </Label.GestureRecognizers>
        </Label>
        
        <Label 
            Text="Scan me to Share "
            VerticalOptions="Center" 
            HorizontalOptions="Center" FontSize="Large" Margin="20,10"/>
        <zxing:BarcodeGeneratorView Format="QrCode" Value="{Binding UserGroupId}" ForegroundColor="{StaticResource Primary}" WidthRequest="100" HeightRequest="100"/>
    </VerticalStackLayout>
</ContentPage>