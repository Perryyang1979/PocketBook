<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PocketBookClient.View.UserInfoPage"
             xmlns:viewmodel="clr-namespace:PocketBookClient.ViewModel"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             Title="{Binding LocalizationResourceManager[SettingTitle], Mode=OneWay}"
             x:DataType="viewmodel:UserInfoPageViewModel">
    <VerticalStackLayout IsVisible="{Binding PanelVisble}">
        <Label 
            Text="{Binding UserName}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Label 
            Text="Scan me to Share "
            VerticalOptions="Center" 
            HorizontalOptions="Center" FontSize="Header" />
        <zxing:BarcodeGeneratorView Format="QrCode" Value="{Binding UserGroupId}" ForegroundColor="{StaticResource Primary}" WidthRequest="100" HeightRequest="100"/>
    </VerticalStackLayout>
</ContentPage>