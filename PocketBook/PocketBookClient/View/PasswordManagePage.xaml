<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PocketBookClient.View.PasswordManagePage"
              xmlns:viewmodel="clr-namespace:PocketBookClient.ViewModel"
              xmlns:local="clr-namespace:PocketBookClient.View"
              xmlns:data="clr-namespace:PocketBookClient.Data"
              Title="{Binding LocalizationResourceManager[Password_Manage], Mode=OneWay}"
              x:DataType="viewmodel:PasswordManageViewModel">
    <VerticalStackLayout>
        <VerticalStackLayout x:Name="ResetPanel" IsVisible="{Binding ResetPanelVisible}" Margin="20,0">
            <Label Text="{Binding LocalizationResourceManager[Password_Manage_Reset] }" Margin="0,10" FontSize="Micro"></Label>
            <HorizontalStackLayout>
                <Label Text="{Binding LocalizationResourceManager[Register_Email] }" VerticalTextAlignment="Center"></Label>
                <Entry Margin="20,10"
                        x:Name="EmailAdress"
                        IsSpellCheckEnabled="False"
                        Text="{Binding Email}"
                        WidthRequest="300"
                        Keyboard="Email"
                        VerticalTextAlignment="End"/>
            </HorizontalStackLayout>
            <Button 
                HorizontalOptions="StartAndExpand"
                Margin="0,10"
                x:Name="resetButton"
                Command="{Binding ResetPasswordCommand}"
                Text="{Binding LocalizationResourceManager[Password_Manage_Reset_ButtonText], Mode=OneWay}"
                HeightRequest="40"
                WidthRequest="100"
                CornerRadius="20"/>
            <Label Margin="0,10" Text="{Binding LocalizationResourceManager[Password_Manage_Reset_Confirm_OK] }" IsVisible="{Binding IsConfirmOK}" TextColor="{StaticResource Color10}"></Label>
            <Label Margin="0,10" Text="{Binding LocalizationResourceManager[Password_Manage_Reset_Confirm_NOK] }" IsVisible="{Binding IsConfirmNotOK}" TextColor="Red"></Label>
        </VerticalStackLayout>
        <VerticalStackLayout x:Name="ChangePanel" IsVisible="{Binding ChangePanelVisible}" Margin="20,0">
            <Label Text="{Binding LocalizationResourceManager[Password_Manage_Change] }" Margin="0,10" FontSize="Micro"></Label>
            <HorizontalStackLayout>
                <Label Text="{Binding LocalizationResourceManager[Password_Manage_Change_Old] }" VerticalTextAlignment="Center" WidthRequest="120"></Label>
                <Entry Margin="20,10"
                        x:Name="oldPassword"
                        IsSpellCheckEnabled="False"
                        Text="{Binding OldPassword}"
                        WidthRequest="120"
                        IsPassword="True"
                        Keyboard="Numeric"
                        VerticalTextAlignment="End"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout>
                <Label Text="{Binding LocalizationResourceManager[Password_Manage_Change_new] }" VerticalTextAlignment="Center" WidthRequest="120"></Label>
                <Entry Margin="20,10"
                        x:Name="newPassword"
                        IsSpellCheckEnabled="False"
                        Text="{Binding NewPassword}"
                        WidthRequest="120"
                        VerticalTextAlignment="End"
                        IsPassword="True"
            Keyboard="Numeric"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout>
                <Label Text="{Binding LocalizationResourceManager[Password_Manage_Change_new_repeat] }" VerticalTextAlignment="Center" WidthRequest="120"></Label>
                <Entry Margin="20,10"
                        x:Name="newRepeatPassword"
                        IsSpellCheckEnabled="False"
                        Text="{Binding RepeatNewPassword}"
                        WidthRequest="120" 
                        IsPassword="True"
                        Keyboard="Numeric"
                        VerticalTextAlignment="End"/>
            </HorizontalStackLayout>
            <Button 
                HorizontalOptions="StartAndExpand"
                Margin="0,10"
                x:Name="changeButton"
                Command="{Binding ChangePasswordCommand}"
                Text="{Binding LocalizationResourceManager[Password_Manage_Change_ButtonText], Mode=OneWay}"
                HeightRequest="40"
                WidthRequest="100"
                CornerRadius="20"/>
            <Label Margin="0,10" Text="{Binding LocalizationResourceManager[Password_Manage_Change_Confirm_OK] }" IsVisible="{Binding IsConfirmOK}" TextColor="{StaticResource Color10}"></Label>
            <Label Margin="0,10" Text="{Binding LocalizationResourceManager[Password_Manage_Change_Confirm_NOK] }" IsVisible="{Binding IsConfirmNotOK}" TextColor="Red"></Label>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentPage>